IMA_PORT=8080
# scripts/install.sh 会替换为随机生成的本机密钥。
IMA_MEILI_API_KEY=replace-with-a-long-local-secret
IMA_MEILI_EMBEDDER_URL=http://127.0.0.1:11434/api/embeddings
IMA_MEILI_EMBEDDER_MODEL=bge-m3
IMA_MEILI_EMBEDDER_DIMENSIONS=1024
# LLM 密钥也可以留空，首次使用时在前端「配置中心」填写（保存在本地 SQLite）。
IMA_LLM_API_KEY=
# openai: base URL normally ends in /v1; anthropic: use the API root.
IMA_LLM_PROTOCOL=openai
# Override this URL to use another OpenAI-compatible chat provider.
IMA_LLM_BASE_URL=https://api.deepseek.com/v1
