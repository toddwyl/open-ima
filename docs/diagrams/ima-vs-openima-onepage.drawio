          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="✕ 取消（单用户所致）" style="html=1;dashed=1;strokeColor=#B45309;endArrow=none;fontSize=10;fontColor=#B45309;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L2" target="R2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="等价职责" style="html=1;dashed=1;strokeColor=#999999;endArrow=none;fontSize=10;fontColor=#666666;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L3" target="R3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="语义等价" style="html=1;dashed=1;strokeColor=#999999;endArrow=none;fontSize=10;fontColor=#666666;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L4" target="R4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="同构 · 范围收窄" style="html=1;dashed=1;strokeColor=#999999;endArrow=none;fontSize=10;fontColor=#666666;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L5" target="R5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="同类替换" style="html=1;dashed=1;strokeColor=#999999;endArrow=none;fontSize=10;fontColor=#666666;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L6" target="R6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="等价 · 进程内嵌" style="html=1;dashed=1;strokeColor=#999999;endArrow=none;fontSize=10;fontColor=#666666;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L7" target="R7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cmp-ima" value="&lt;b&gt;优点&lt;/b&gt;　弹性扩展 · 多团队协作 · 权限体系完备 · 数据规模无上限&lt;br&gt;&lt;b&gt;代价&lt;/b&gt;　云基础设施依赖 · 成本高 · 数据离开本机 · ES JVM 资源重&lt;br&gt;&lt;b&gt;适用&lt;/b&gt;　企业团队知识库 · 海量数据共享 · 细粒度权限管控" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DCE4;fontSize=12;align=left;spacing=14;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="80" y="950" width="760" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cmp-oi" value="&lt;b&gt;优点&lt;/b&gt;　隐私（文档不出本机）· 零运维 · 一键部署 · 离线可用 · 资源占用低&lt;br&gt;&lt;b&gt;代价&lt;/b&gt;　单机容量上限 · 无多用户协作与权限 · 可用性靠单机&lt;br&gt;&lt;b&gt;适用&lt;/b&gt;　个人知识管理 · 隐私敏感文档 · 内网 / 离线环境" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0C9A6;fontSize=12;align=left;spacing=14;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1200" y="950" width="760" height="150" as="geometry" />
        </mxCell>
        <mxCell id="stmt" value="差异的本质是约束，不是方法论：云端多租户让分布式问题（入库洪峰 · 查询扇出 · 租户隔离 · 权限协作）成立，本地单用户使其整体归零。&lt;br&gt;组件替换（MQ→内嵌队列 · ES→Meilisearch · 砍掉权限）只是这个根本差异的三个症状——架构思想完整保留。" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1B1B18;" vertex="1" parent="1">
          <mxGeometry x="60" y="1126" width="1920" height="56" as="geometry" />
        </mxCell>
        <mxCell id="src" value="参考：《IMA知识库：从0到1的架构设计与实践》(cloud.tencent.com/developer/article/2608466) · 《ima基于腾讯云ES的千亿级AI知识库架构实践》(developer.cloud.tencent.com/article/2747411) · open-ima V1 设计文档" style="text;html=1;align=center;fontSize=10;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="1196" width="1960" height="26" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
