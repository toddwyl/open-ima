        </mxCell>
        <mxCell id="title" value="&lt;b&gt;&lt;font style=font-size:22px&gt;ima 知识库架构对比：云端原型 → 本地复刻&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=font-size:12px;color:#75756C&gt;同一套方法论（分层解耦 · 异步削峰 · 最终一致 · 混合检索），在不同部署约束下的两种实现&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1960" height="60" as="geometry" />
        </mxCell>
        <mxCell id="zone-ima-t" value="腾讯 ima · 云端多租户 SaaS" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#3E5C76;" vertex="1" parent="1">
          <mxGeometry x="80" y="112" width="760" height="28" as="geometry" />
        </mxCell>
        <mxCell id="zone-oi-t" value="open-ima · 本地单机 · 个人知识库" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#B45309;" vertex="1" parent="1">
          <mxGeometry x="1200" y="112" width="760" height="28" as="geometry" />
        </mxCell>
