        </mxCell>
        <mxCell id="L1" value="&lt;b&gt;用户（个人 / 团队）&lt;/b&gt;&lt;br&gt;&lt;font style=font-size:11px;color:#667&gt;多租户 · 千万级知识库&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fillColor=#EAF1FB;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="170" width="760" height="80" as="geometry" />
        </mxCell>
        <mxCell id="R1" value="&lt;b&gt;单个用户 · 本机浏览器&lt;/b&gt;&lt;br&gt;&lt;font style=font-size:11px;color:#667&gt;React SPA（Go embed 托管）· 数据不出本机&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fillColor=#FCEFE3;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1200" y="170" width="760" height="80" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="&lt;b&gt;统一权限网关&lt;/b&gt;&lt;br&gt;&lt;font style=font-size:11px;color:#667&gt;权限深度建模 · 团队协作的安全底座&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fillColor=#F1E9F5;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="270" width="760" height="70" as="geometry" />
        </mxCell>
        <mxCell id="R2" value="&lt;b&gt;✕ 权限体系（V1 不做）&lt;/b&gt;&lt;br&gt;&lt;font style=font-size:11px;color:#888&gt;单用户无授权问题 · 演进路径已预留&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontColor=#888888;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1400" y="270" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="&lt;b&gt;统一接入层&lt;/b&gt;&lt;br&gt;&lt;font style=font-size:11px;color:#667&gt;知识库服务 · 上传管理 · 媒体中心（Media 面向用户管理）&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fillColor=#EAF1FB;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="360" width="760" height="100" as="geometry" />
        </mxCell>
        <mxCell id="R3" value="&lt;b&gt;app · Go 1.26 单二进制&lt;/b&gt;&lt;br&gt;&lt;font style=font-size:11px;color:#667&gt;HTTP/SSE 接口 · 用例编排 · documents 状态机（对应 Media）&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fillColor=#FCEFE3;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1200" y="360" width="760" height="100" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="&lt;b&gt;消息队列集群&lt;/b&gt;&lt;br&gt;&lt;font style=font-size:11px;color:#667&gt;削峰填谷 · 解耦请求与解析重任务&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fillColor=#FFF6DC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="480" width="760" height="80" as="geometry" />
        </mxCell>
        <mxCell id="R4" value="&lt;b&gt;SQLite jobs 表 + worker pool&lt;/b&gt;&lt;br&gt;&lt;font style=font-size:11px;color:#667&gt;内嵌队列：缓冲 · 指数退避重试 · 崩溃恢复（ResetStale）&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fillColor=#FFF6DC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1200" y="480" width="760" height="80" as="geometry" />
        </mxCell>
        <mxCell id="L5" value="&lt;b&gt;媒体解析服务（独立解析层）&lt;/b&gt;&lt;br&gt;&lt;font style=font-size:11px;color:#667&gt;按类型路由 · 20+ 格式 → 统一 Chunk&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fillColor=#EAF1FB;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="580" width="760" height="90" as="geometry" />
        </mxCell>
        <mxCell id="R5" value="&lt;b&gt;parser · Python FastAPI sidecar&lt;/b&gt;&lt;br&gt;&lt;font style=font-size:11px;color:#667&gt;注册表按类型路由 · 6 种格式 → Chunk · 不触网&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fillColor=#EAF1FB;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
