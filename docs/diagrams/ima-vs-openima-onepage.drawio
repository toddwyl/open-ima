        </mxCell>
        <mxCell id="L6" value="&lt;b&gt;Elasticsearch 集群&lt;/b&gt;&lt;br&gt;&lt;font style=font-size:11px;color:#667&gt;BM25 + 向量 KNN + RRF · 多集群路由 / bbq_disk / rollover（为千亿级数据而生）&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fillColor=#E9F4E6;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="690" width="760" height="110" as="geometry" />
        </mxCell>
        <mxCell id="R6" value="&lt;b&gt;Meilisearch + Ollama bge-m3&lt;/b&gt;&lt;br&gt;&lt;font style=font-size:11px;color:#667&gt;原生 hybrid（BM25 + 向量 + RRF）· kb_biz_id 过滤做库级隔离 · 本地 Embedding&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fillColor=#E9F4E6;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1200" y="690" width="760" height="110" as="geometry" />
        </mxCell>
        <mxCell id="L7" value="&lt;b&gt;异步对账服务&lt;/b&gt;&lt;br&gt;&lt;font style=font-size:11px;color:#667&gt;Media ↔ Chunk 状态核对 · 最终一致&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fillColor=#F1E9F5;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1">
