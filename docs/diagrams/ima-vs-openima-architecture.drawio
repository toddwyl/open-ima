        <mxCell id="oi-edge-b1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="oi-iface" target="oi-applayer">
          <mxGeometry relative="1" as="geometry" />
