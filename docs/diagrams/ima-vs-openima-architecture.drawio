  <diagram name="2-openima-本地架构" id="page-openima">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="oi-title" value="open-ima 架构（本地单机 · 个人知识库）&#xa;复刻 ima 的分层解耦、异步削峰与混合检索；权限层按单用户场景整块砍掉" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="oi-user" value="个人用户" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="590" y="110" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="oi-spa" value="浏览器 SPA&#xa;React（Go embed 托管）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="255" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="oi-band-ingest" value="统一接入层（稳定）· app：Go 单二进制进程" style="swimlane;startSize=30;fillColor=#f7f9fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="210" width="820" height="160" as="geometry" />
        </mxCell>
        <mxCell id="oi-iface" value="interfaces · HTTP / SSE&#xa;REST API · 流式问答" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="oi-band-ingest">
          <mxGeometry x="30" y="50" width="240" height="85" as="geometry" />
        </mxCell>
        <mxCell id="oi-applayer" value="application · 用例编排&#xa;+ port（外部能力端口）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="oi-band-ingest">
          <mxGeometry x="300" y="50" width="240" height="85" as="geometry" />
        </mxCell>
        <mxCell id="oi-domain" value="domain · Media / Chunk 两层模型&#xa;实体 · 状态机" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="oi-band-ingest">
          <mxGeometry x="570" y="50" width="220" height="85" as="geometry" />
        </mxCell>
        <mxCell id="oi-dddnote" value="DDD 分层，依赖方向由 architecture_test.go 固化；worker pool 与对账 ticker 同在 app 进程内" style="text;html=1;align=left;fontSize=10;fontColor=#75756c;" vertex="1" parent="oi-band-ingest">
          <mxGeometry x="30" y="140" width="760" height="16" as="geometry" />
        </mxCell>
        <mxCell id="oi-jobs" value="SQLite jobs 任务表&#xa;对标 MQ · 削峰填谷" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="420" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="oi-note-retry" value="worker 事务内 Claim；失败指数退避 1m / 5m / 15m（≤3 次）后标记 failed" style="text;html=1;align=left;fontSize=10;fontColor=#75756c;" vertex="1" parent="1">
          <mxGeometry x="620" y="430" width="290" height="40" as="geometry" />
        </mxCell>
        <mxCell id="oi-band-parse" value="独立解析层（灵活 · 识别并隔离变化）· parser 进程" style="swimlane;startSize=30;fillColor=#f7f9fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="520" width="820" height="150" as="geometry" />
        </mxCell>
        <mxCell id="oi-parser" value="parser · Python FastAPI sidecar&#xa;注册表按类型路由：PDF / DOCX / PPTX / MD / 网页&#xa;输出统一 Chunk 结构 · 不触网" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="oi-band-parse">
          <mxGeometry x="30" y="45" width="660" height="90" as="geometry" />
        </mxCell>
        <mxCell id="oi-band-rag" value="底层 RAG 服务（索引 · 检索 · AI 应用）· meilisearch 进程" style="swimlane;startSize=30;fillColor=#f7f9fc;strokeColor=#82b366;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="720" width="820" height="150" as="geometry" />
        </mxCell>
        <mxCell id="oi-meili" value="Meilisearch v1.10&#xa;BM25 + 向量 KNN + RRF hybrid&#xa;内置 jieba 中文 · 托管 embedding" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="oi-band-rag">
          <mxGeometry x="30" y="40" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="oi-search" value="RAG 问答 · Agent（ReAct 循环）&#xa;Query 改写 → 双路召回 → RRF → LLM&#xa;工具：search_knowledge / read_document / list_documents / web_search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="oi-band-rag">
          <mxGeometry x="360" y="40" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="oi-reconcile" value="对账 ticker&#xa;补偿式删除&#xa;Meili → 文件 → DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="oi-band-rag">
          <mxGeometry x="610" y="40" width="180" height="100" as="geometry" />
