  <diagram name="3-优缺点对比" id="page-compare">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cmp-title" value="优缺点与适用场景：一套方法论，两种约束" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="36" as="geometry" />
        </mxCell>
        <mxCell id="cmp-h1" value="维度" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b1b18;strokeColor=#1b1b18;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cmp-h2" value="腾讯 ima（云端多租户）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b1b18;strokeColor=#1b1b18;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="200" y="70" width="660" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cmp-h3" value="open-ima（本地单机）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b1b18;strokeColor=#1b1b18;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="860" y="70" width="580" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r1a" value="定位与规模" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f6f1;strokeColor=#e4e4dc;fontSize=12;fontStyle=1;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r1b" value="云端 AI 工作台 ima 的知识库后端&#xa;• 千万级知识库，ES 侧近千亿级数据&#xa;• 多租户团队协作，权限体系是生命线" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f6f1;strokeColor=#e4e4dc;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="200" y="120" width="660" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r1c" value="ima 知识库能力的本地部署复刻版&#xa;• 单机单用户：每个人的独立个人知识库&#xa;• 四个进程 compose 一键启动，数据不出本机" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f6f1;strokeColor=#e4e4dc;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="860" y="120" width="580" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r2a" value="架构优点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e4e4dc;fontSize=12;fontStyle=1;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="160" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r2b" value="• 弹性扩展：多集群路由 + rollover，规模无上限&#xa;• 权限深度建模 + 统一权限网关，团队共享安全&#xa;• 一套 ES 引擎承载全文 / 向量 / 混合检索&#xa;• 成熟中文生态：拼音、模糊、高亮开箱即用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e4e4dc;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="200" y="220" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r2c" value="• 隐私：文档不出本机，Embedding 走本地 Ollama&#xa;• 零运维：无 MQ / PG 等外部组件，SQLite WAL 足够&#xa;• 资源占用低：Meili ~150MB vs ES 600MB+ / 1GB 内存&#xa;• 离线可用，compose 一键启动" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e4e4dc;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="860" y="220" width="580" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r3a" value="架构代价" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f6f1;strokeColor=#e4e4dc;fontSize=12;fontStyle=1;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="160" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r3b" value="• 依赖云基础设施，成本高&#xa;• 数据离开本机，隐私依赖服务商承诺&#xa;• ES JVM 资源重：镜像 600MB+、内存 1GB 起" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f6f1;strokeColor=#e4e4dc;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="200" y="350" width="660" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r3c" value="• 容量与并发受单机限制&#xa;• 无多用户协作与权限体系&#xa;• 可用性靠单机，无副本容灾" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f6f1;strokeColor=#e4e4dc;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="860" y="350" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r4a" value="适用场景" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e4e4dc;fontSize=12;fontStyle=1;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="160" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r4b" value="企业团队知识库&#xa;海量数据共享协作&#xa;细粒度权限管控" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e4e4dc;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="200" y="460" width="660" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r4c" value="个人知识管理&#xa;隐私敏感文档 · 内网 / 离线环境&#xa;低成本拥有 RAG 问答能力" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e4e4dc;fontSize=12;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="860" y="460" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cmp-state-bar" value="" style="rounded=0;html=1;fillColor=#b45309;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="608" width="4" height="56" as="geometry" />
        </mxCell>
        <mxCell id="cmp-state" value="ima 解决「千万租户如何共用一套系统」；open-ima 解决「一个人如何零成本拥有同样的能力」。&#xa;差异不在方法论，而在约束：隐私、成本、中文检索质量、运维——取舍由此推导。" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1b1b18;" vertex="1" parent="1">
          <mxGeometry x="60" y="606" width="1380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cmp-src" value="参考：《IMA知识库：从0到1的架构设计与实践》(cloud.tencent.com/developer/article/2608466) · 《ima基于腾讯云ES的千亿级AI知识库架构实践》(developer.cloud.tencent.com/article/2747411) · open-ima V1 设计文档" style="text;html=1;align=left;fontSize=10;fontColor=#75756c;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1360" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
