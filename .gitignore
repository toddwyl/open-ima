venv/
__pycache__/
*.pyc

# 环境与本地配置
.env
.env.local
*.local
.local/

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/

# Playwright 浏览器测试快照
.playwright-cli/

# 手工测试留痕（截图、临时夹具）
test-artifacts/
dumps/

